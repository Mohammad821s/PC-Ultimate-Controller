<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layoutDirection="ltr"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_art"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/w_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Nothing playing"
                android:textColor="@color/w_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/w_muted"
                android:textSize="12.5sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/w_play"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/w_accent_round"
            android:contentDescription="Play or pause"
            android:scaleType="center"
            android:src="@drawable/ic_play"
            android:tint="@color/w_on_accent" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/w_sc1"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:contentDescription="Shortcut"
            android:scaleType="fitCenter" />
        <ImageView
            android:id="@+id/w_sc2"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:contentDescription="Shortcut"
            android:scaleType="fitCenter" />
        <ImageView
            android:id="@+id/w_sc3"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:contentDescription="Shortcut"
            android:scaleType="fitCenter" />
        <ImageView
            android:id="@+id/w_sc4"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:contentDescription="Shortcut"
            android:scaleType="fitCenter" />
        <ImageView
            android:id="@+id/w_pad"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/w_tile"
            android:contentDescription="Floating touchpad"
            android:scaleType="center"
            android:src="@drawable/ic_pad"
            android:tint="@color/w_accent" />
    </LinearLayout>
</LinearLayout>
