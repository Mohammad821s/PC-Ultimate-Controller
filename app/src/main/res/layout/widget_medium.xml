<?xml version="1.0" encoding="utf-8"?>
<!-- Colors and shapes are drawn by Widgets.kt (per-widget style), so the layout only arranges. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layoutDirection="ltr"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/w_bg"
        android:src="@drawable/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
        <ImageView
            android:id="@+id/w_art"
            android:src="@drawable/ic_music"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="Open the app" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="10dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/w_title"
                android:textColor="@color/w_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Nothing playing"
                android:fontFamily="sans-serif-medium"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/w_artist"
                android:textColor="@color/w_muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="12.5sp" />
        </LinearLayout>
        <ImageView
            android:id="@+id/w_play"
            android:src="@drawable/ic_play"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:scaleType="fitCenter"
            android:contentDescription="Play or pause" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_row_ctl"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.8"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">
        <ImageView
            android:id="@+id/w_back"
            android:src="@drawable/ic_back10"
            android:layout_width="0dp"
            android:layout_height="match_parent"
        android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:scaleType="fitCenter"
            android:adjustViewBounds="false"
            android:contentDescription="Back 10 seconds" />
        <ImageView
            android:id="@+id/w_prev"
            android:src="@drawable/ic_prev"
            android:layout_width="0dp"
            android:layout_height="match_parent"
        android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:scaleType="fitCenter"
            android:adjustViewBounds="false"
            android:contentDescription="Previous" />
        <ImageView
            android:id="@+id/w_play2"
            android:src="@drawable/ic_play"
            android:layout_width="0dp"
            android:layout_height="match_parent"
        android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:scaleType="fitCenter"
            android:adjustViewBounds="false"
            android:contentDescription="Play or pause" />
        <ImageView
            android:id="@+id/w_next"
            android:src="@drawable/ic_next"
            android:layout_width="0dp"
            android:layout_height="match_parent"
        android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:scaleType="fitCenter"
            android:adjustViewBounds="false"
            android:contentDescription="Next" />
        <ImageView
            android:id="@+id/w_fwd"
            android:src="@drawable/ic_fwd10"
            android:layout_width="0dp"
            android:layout_height="match_parent"
        android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:scaleType="fitCenter"
            android:adjustViewBounds="false"
            android:contentDescription="Forward 10 seconds" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_row_sc"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">
        <ImageView
            android:id="@+id/w_sc1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
        android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:scaleType="fitCenter"
            android:adjustViewBounds="false"
            android:contentDescription="Shortcut" />
        <ImageView
            android:id="@+id/w_sc2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
        android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:scaleType="fitCenter"
            android:adjustViewBounds="false"
            android:contentDescription="Shortcut" />
        <ImageView
            android:id="@+id/w_sc3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
        android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:scaleType="fitCenter"
            android:adjustViewBounds="false"
            android:contentDescription="Shortcut" />
        <ImageView
            android:id="@+id/w_sc4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
        android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:scaleType="fitCenter"
            android:adjustViewBounds="false"
            android:contentDescription="Shortcut" />
        <ImageView
            android:id="@+id/w_sc5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
        android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:scaleType="fitCenter"
            android:adjustViewBounds="false"
            android:contentDescription="Shortcut" />
        <ImageView
            android:id="@+id/w_sc6"
            android:layout_width="0dp"
            android:layout_height="match_parent"
        android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:scaleType="fitCenter"
            android:adjustViewBounds="false"
            android:contentDescription="Shortcut" />
        <ImageView
            android:id="@+id/w_pad"
            android:src="@drawable/ic_pad"
            android:layout_width="0dp"
            android:layout_height="match_parent"
        android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:scaleType="fitCenter"
            android:adjustViewBounds="false"
            android:contentDescription="Floating touchpad" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
