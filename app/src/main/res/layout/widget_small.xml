<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layoutDirection="ltr"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <ImageView
        android:id="@+id/w_art"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/w_title"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="Nothing playing"
        android:textColor="@color/w_text"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_play"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/w_accent_rect"
            android:contentDescription="Play or pause"
            android:scaleType="center"
            android:src="@drawable/ic_play"
            android:tint="@color/w_on_accent" />

        <FrameLayout
            android:layout_width="8dp"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/w_next"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/w_tile"
            android:contentDescription="Next"
            android:scaleType="center"
            android:src="@drawable/ic_next"
            android:tint="@color/w_text" />
    </LinearLayout>
</LinearLayout>
