@echo off
cd /d "%~dp0"
powershell -NoProfile -Command "$o=@(); $s=Get-MpComputerStatus; $o+='Defender service: '+$s.AMServiceEnabled; $o+='Antivirus: '+$s.AntivirusEnabled; $o+='Real-time protection: '+$s.RealTimeProtectionEnabled; $o+='Antispyware: '+$s.AntispywareEnabled; $o+='Tamper protection: '+$s.IsTamperProtected; $o+='Signatures updated: '+$s.AntivirusSignatureLastUpdated; $o+='Product state: '+(Get-CimInstance -Namespace root/SecurityCenter2 -ClassName AntiVirusProduct | ForEach-Object { $_.displayName + ' (' + $_.productState + ')' }) -join ', '; $o+='360 processes: '+((Get-Process | Where-Object { $_.Name -match '360|QHSafe|ZhuDong|QHActive' } | Select-Object -ExpandProperty Name) -join ', '); $o+='360 services: '+((Get-Service | Where-Object { $_.Name -match '360|QH|ZhuDong' -or $_.DisplayName -match '360' } | ForEach-Object { $_.Name + '=' + $_.Status }) -join ', '); $o+='360 folders: '+((@('C:\Program Files (x86)\360','C:\Program Files\360','C:\ProgramData\360TotalSecurity') | Where-Object { Test-Path $_ }) -join ', '); $o | Out-File -Encoding utf8 defender.log" > defender.err 2>&1
